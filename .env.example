# Learnify AI Environment Variables Example
# Copy to .env.local to configure

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Gemini API Key (either name works)
GEMINI_API_KEY=your-gemini-api-key
AI_API_KEY=your-gemini-api-key

# Optional custom AI endpoint (defaults to gemini-2.0-flash if not provided)
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
